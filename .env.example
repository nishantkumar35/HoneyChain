# HoneyChain — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Django ────────────────────────────────────────────────────────
# Generate a secret key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ── Blockchain ────────────────────────────────────────────────────
# Start Hardhat node: cd smart_contract && npx hardhat node
BLOCKCHAIN_NODE_URL=http://127.0.0.1:8545

# Deploy contract: cd smart_contract && npx hardhat run scripts/deploy.js --network localhost
# Then paste the printed contract address here:
CONTRACT_ADDRESS=

# Hardhat Account #0 private key (safe for local dev ONLY — never use in production)
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ── App ───────────────────────────────────────────────────────────
SITE_BASE_URL=http://127.0.0.1:8000
